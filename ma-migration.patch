@@ -0,0 +1,207 @@
+/*
+  Ma design system: tokens
+  ------------------------------------------------------------------
+  Drop-in replacement for the :root and @theme blocks at the top of
+  src/app/globals.css (Tailwind v4). One palette, two themes:
+
+    Washi (light, default)   warm paper, ink, indigo
+    Sumi  (dark)             ink-black, ivory, pale indigo
+
+  Themes follow the system setting. Set data-theme="light" or
+  data-theme="dark" on <html> to force one. The old `.editorial-page`
+  palette scope is no longer needed: delete it.
+
+  Legacy names (midnight, ivory, navy, gold, pride-blue ...) still
+  resolve so existing components keep working while you migrate.
+*/
+
+/* ── 1. Theme-independent tokens ─────────────────────────────────── */
+:root {
+  /* Layout (8px base; Tailwind spacing steps of 2 = 8px) */
+  --layout-max: 72rem;            /* 12-column container */
+  --reading-max: 42rem;           /* long-form text, about 65 characters */
+  --page-gutter: clamp(1.5rem, 5vw, 3rem);
+  --section-space: clamp(4rem, 8vw, 6rem);      /* ma: standard interval */
+  --section-space-lg: clamp(6rem, 12vw, 8rem);  /* ma: hero and closing */
+  --grid-gap: clamp(1rem, 2vw, 1.5rem);
+
+  /* Shape */
+  --radius-seal: 0.25rem;     /* 4: seal, kbd */
+  --radius-control: 0.5rem;   /* 8: fields, small controls */
+  --radius-card: 0.75rem;     /* 12: panels, cards */
+  --radius-overlay: 1.25rem;  /* 20: dialogs, sheets, chat */
+  --radius-pill: 999px;       /* buttons, chips */
+  /* Photographs and screenshots stay square inside a hairline frame. */
+
+  /* Motion */
+  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);       /* arrivals */
+  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);     /* state changes */
+  --dur-fast: 120ms;   /* hover, press */
+  --dur-base: 200ms;   /* state changes */
+  --dur-slow: 360ms;   /* panels, reveals */
+  --dur-page: 560ms;   /* route-level arrivals */
+  --ease-premium: var(--ease-out); /* legacy alias */
+
+  /* Fonts are provided by next/font (see docs/MIGRATION.md) */
+  --font-sans-stack: var(--font-plex-sans), ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  --font-mono-stack: var(--font-plex-mono), ui-monospace, "SF Mono", Menlo, monospace;
+  --font-mincho-stack: var(--font-mincho), "Hiragino Mincho ProN", "Yu Mincho", serif;
+}
+
+/* ── 2. Washi (light, default) ───────────────────────────────────── */
+:root {
+  color-scheme: light;
+  --ui-background: #F4F1EA;  /* paper */
+  --ui-surface: #EAE6DC;     /* panels */
+  --ui-elevated: #DEDACF;    /* raised controls */
+  --ui-text: #20221F;        /* ink */
+  --ui-muted: #575D57;       /* supporting ink */
+  --ui-accent: #174E72;      /* indigo: links, focus, primary action */
+  --ui-on-accent: #F4F1EA;   /* text on indigo */
+  --ui-action: var(--ui-accent);
+  --ui-border: #7C8075;      /* control outlines (3:1 or better) */
+  --ui-rule: #C9C5B8;        /* hairlines and dividers (decorative) */
+  --ui-seal: #B3321F;        /* the single vermilion mark. Max one per view. */
+  --ui-success: #1F6B4A;
+  --ui-warning: #7A5400;
+  --ui-danger: #9B1C31;
+  --ui-shadow: 32 34 31;     /* rgb triplet for shadows */
+  --ui-scrim: rgb(32 34 31 / 0.45);
+}
+
+/* ── 3. Sumi (dark) ──────────────────────────────────────────────── */
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    color-scheme: dark;
+    --ui-background: #0B1018;
+    --ui-surface: #131C29;
+    --ui-elevated: #1B293C;
+    --ui-text: #F4F0E8;
+    --ui-muted: #BBC7D8;
+    --ui-accent: #A8C9FF;
+    --ui-on-accent: #0B1018;
+    --ui-border: #667994;
+    --ui-rule: #2A3A52;
+    --ui-seal: #F08A74;
+    --ui-success: #8FE0B5;
+    --ui-warning: #F3D390;
+    --ui-danger: #FFB4BD;
+    --ui-shadow: 0 0 0;
+    --ui-scrim: rgb(0 0 0 / 0.6);
+  }
+}
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --ui-background: #0B1018;
+  --ui-surface: #131C29;
+  --ui-elevated: #1B293C;
+  --ui-text: #F4F0E8;
+  --ui-muted: #BBC7D8;
+  --ui-accent: #A8C9FF;
+  --ui-on-accent: #0B1018;
+  --ui-border: #667994;
+  --ui-rule: #2A3A52;
+  --ui-seal: #F08A74;
+  --ui-success: #8FE0B5;
+  --ui-warning: #F3D390;
+  --ui-danger: #FFB4BD;
+  --ui-shadow: 0 0 0;
+  --ui-scrim: rgb(0 0 0 / 0.6);
+}
+
+/* ── 4. Legacy aliases (remove once components are migrated) ─────── */
+:root {
+  --color-midnight: var(--ui-background);
+  --color-surface: var(--ui-surface);
+  --color-navy: var(--ui-elevated);
+  --color-ivory: var(--ui-text);
+  --color-muted: var(--ui-muted);
+  --color-accent: var(--ui-accent);
+  --color-pride-blue: var(--ui-action);
+  --color-border: var(--ui-border);
+  --color-gold: var(--ui-accent);
+  --color-blue: var(--ui-accent);
+  --color-green: var(--ui-success);
+  --color-success: var(--ui-success);
+  --color-warning: var(--ui-warning);
+  --color-danger: var(--ui-danger);
+  --color-magenta: var(--ui-danger);
+  --background: var(--ui-background);
+  --foreground: var(--ui-text);
+}
+
+/* ── 5. Tailwind v4 registration ─────────────────────────────────── */
+@theme inline {
+  /* Colour. Prefer the new names; legacy names stay for now. */
+  --color-paper: var(--ui-background);
+  --color-ink: var(--ui-text);
+  --color-indigo: var(--ui-accent);
+  --color-rule: var(--ui-rule);
+  --color-seal: var(--ui-seal);
+  --color-on-accent: var(--ui-on-accent);
+  --color-elevated: var(--ui-elevated);
+  --color-midnight: var(--ui-background);
+  --color-surface: var(--ui-surface);
+  --color-navy: var(--ui-elevated);
+  --color-ivory: var(--ui-text);
+  --color-muted: var(--ui-muted);
+  --color-accent: var(--ui-accent);
+  --color-pride-blue: var(--ui-action);
+  --color-border: var(--ui-border);
+  --color-gold: var(--ui-accent);
+  --color-blue: var(--ui-accent);
+  --color-green: var(--ui-success);
+  --color-success: var(--ui-success);
+  --color-warning: var(--ui-warning);
+  --color-danger: var(--ui-danger);
+  --color-magenta: var(--ui-danger);
+
+  /* Fonts. font-body and font-display remain as aliases of font-sans. */
+  --font-sans: var(--font-sans-stack);
+  --font-body: var(--font-sans-stack);
+  --font-display: var(--font-sans-stack);
+  --font-mono: var(--font-mono-stack);
+  --font-mincho: var(--font-mincho-stack);
+
+  /* Type scale. Each name sets size, line height, tracking and weight. */
+  --text-label: 0.75rem;
+  --text-label--line-height: 1.5;
+  --text-label--letter-spacing: 0.08em;
+  --text-label--font-weight: 600;
+  --text-caption: 0.875rem;
+  --text-caption--line-height: 1.5;
+  --text-body: 1rem;
+  --text-body--line-height: 1.65;
+  --text-lead: 1.25rem;
+  --text-lead--line-height: 1.55;
+  --text-lead--letter-spacing: -0.01em;
+  --text-title: 1.5rem;
+  --text-title--line-height: 1.3;
+  --text-title--letter-spacing: -0.015em;
+  --text-title--font-weight: 600;
+  --text-heading: clamp(1.75rem, 3.2vw, 2.5rem);
+  --text-heading--line-height: 1.15;
+  --text-heading--letter-spacing: -0.025em;
+  --text-heading--font-weight: 600;
+  --text-headline: clamp(2.5rem, 5.5vw, 4.5rem);
+  --text-headline--line-height: 1.05;
+  --text-headline--letter-spacing: -0.035em;
+  --text-headline--font-weight: 600;
+  --text-display: clamp(3rem, 7vw, 6rem);
+  --text-display--line-height: 1.02;
+  --text-display--letter-spacing: -0.045em;
+  --text-display--font-weight: 600;
+
+  /* Shape */
+  --radius-seal: 0.25rem;
+  --radius-control: 0.5rem;
+  --radius-card: 0.75rem;
+  --radius-overlay: 1.25rem;
+
+  /* Elevation: flat by default, two steps only. */
+  --shadow-raised: 0 1px 2px rgb(var(--ui-shadow) / 0.06), 0 4px 12px rgb(var(--ui-shadow) / 0.07);
+  --shadow-overlay: 0 8px 32px rgb(var(--ui-shadow) / 0.16), 0 2px 8px rgb(var(--ui-shadow) / 0.10);
+
+  /* Motion */
+  --ease-ma: var(--ease-out);
+}
