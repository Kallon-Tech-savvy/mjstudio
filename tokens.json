{
  "$description": "Ma design system tokens. Source of truth for design tools; mirrors css/tokens.css.",
  "version": "1.0.0",
  "themes": {
    "washi": {
      "background": "#F4F1EA", "surface": "#EAE6DC", "elevated": "#DEDACF",
      "text": "#20221F", "muted": "#575D57",
      "accent": "#174E72", "onAccent": "#F4F1EA",
      "border": "#7C8075", "rule": "#C9C5B8", "seal": "#B3321F",
      "success": "#1F6B4A", "warning": "#7A5400", "danger": "#9B1C31"
    },
    "sumi": {
      "background": "#0B1018", "surface": "#131C29", "elevated": "#1B293C",
      "text": "#F4F0E8", "muted": "#BBC7D8",
      "accent": "#A8C9FF", "onAccent": "#0B1018",
      "border": "#667994", "rule": "#2A3A52", "seal": "#F08A74",
      "success": "#8FE0B5", "warning": "#F3D390", "danger": "#FFB4BD"
    }
  },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "mincho": "Zen Old Mincho",
    "weights": [400, 500, 600]
  },
  "type": {
    "label":    { "size": "0.75rem", "line": 1.5,  "tracking": "0.08em",  "weight": 600, "case": "upper" },
    "caption":  { "size": "0.875rem", "line": 1.5, "tracking": "0",       "weight": 400 },
    "body":     { "size": "1rem",    "line": 1.65, "tracking": "0",       "weight": 400 },
    "reading":  { "size": "1.0625rem", "line": 1.8, "tracking": "0",      "weight": 400 },
    "lead":     { "size": "1.25rem", "line": 1.55, "tracking": "-0.01em", "weight": 400 },
    "title":    { "size": "1.5rem",  "line": 1.3,  "tracking": "-0.015em", "weight": 600 },
    "heading":  { "size": "clamp(1.75rem, 3.2vw, 2.5rem)", "line": 1.15, "tracking": "-0.025em", "weight": 600 },
    "headline": { "size": "clamp(2.5rem, 5.5vw, 4.5rem)",  "line": 1.05, "tracking": "-0.035em", "weight": 600 },
    "display":  { "size": "clamp(3rem, 7vw, 6rem)",        "line": 1.02, "tracking": "-0.045em", "weight": 600 }
  },
  "space": { "unit": "8px", "steps": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128] },
  "layout": { "max": "72rem", "reading": "42rem", "columns": 12, "splits": ["3/6/3", "4/8", "12"] },
  "radius": { "seal": "4px", "control": "8px", "card": "12px", "overlay": "20px", "pill": "999px", "figure": "0" },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "360ms", "page": "560ms" },
    "easing": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "inOut": "cubic-bezier(0.4, 0, 0.2, 1)" }
  },
  "contrastMeasured": {
    "washi": { "textOnBackground": 14.21, "mutedOnBackground": 5.99, "mutedOnElevated": 4.84, "accentOnBackground": 7.86, "borderOnBackground": 3.58, "borderOnSurface": 3.24 },
    "sumi":  { "textOnBackground": 16.77, "mutedOnBackground": 11.14, "mutedOnElevated": 8.59, "accentOnBackground": 11.31, "borderOnBackground": 4.29, "borderOnSurface": 3.86 }
  }
}
