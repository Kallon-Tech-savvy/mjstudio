@@ -0,0 +1,49 @@
+/** Helpers for sharing a gallery link and PIN by hand (WhatsApp, SMS, any messenger). */
+
+export { buildClientLink, readSecretFromHash } from "@/lib/access-link";
+
+/** wa.me needs an international number. A local number like 076... would open the wrong chat, so only use "+..." numbers. */
+export function whatsappUrl(text: string, phone?: string | null): string {
+  const trimmed = (phone ?? "").trim();
+  const digits = trimmed.replace(/\D/g, "");
+  const international = trimmed.startsWith("+") && digits.length >= 8 && digits.length <= 15;
+  return `https://wa.me/${international ? digits : ""}?text=${encodeURIComponent(text)}`;
+}
+
+export function linkMessage(input: { clientName?: string; galleryName: string; link: string }): string {
+  const greeting = input.clientName ? `Hi ${input.clientName},` : "Hi,";
+  return `${greeting} your photos "${input.galleryName}" are ready to view: ${input.link}\n\nI'll send your PIN in a separate message.`;
+}
+
+export function pinMessage(pin: string): string {
+  return `Your PIN for the gallery is ${pin}`;
+}
+
+/** "012345" -> "012 345" for easier reading aloud. Copy always uses the plain digits. */
+export const groupPin = (pin: string) => (pin.length === 6 ? `${pin.slice(0, 3)} ${pin.slice(3)}` : pin);
+
+/** Clipboard API needs a secure context; fall back to a hidden textarea so Copy also works over plain http. */
+export async function copyText(text: string): Promise<boolean> {
+  try {
+    if (navigator.clipboard && window.isSecureContext) {
+      await navigator.clipboard.writeText(text);
+      return true;
+    }
+  } catch {
+    /* fall through to the legacy path */
+  }
+  try {
+    const area = document.createElement("textarea");
+    area.value = text;
+    area.setAttribute("readonly", "");
+    area.style.position = "fixed";
+    area.style.opacity = "0";
+    document.body.appendChild(area);
+    area.select();
+    const ok = document.execCommand("copy");
+    document.body.removeChild(area);
+    return ok;
+  } catch {
+    return false;
+  }
+}
