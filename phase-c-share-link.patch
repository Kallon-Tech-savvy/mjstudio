+/**
+ * The secret travels in the URL fragment (#secret=...). Browsers never send the fragment to a server,
+ * so it stays out of access logs and proxies, and the app sends `Referrer-Policy: no-referrer`.
+ */
+export function buildClientLink(origin: string, galleryId: string, secretToken: string): string {
+  return `${origin}/client/access?galleryId=${encodeURIComponent(galleryId)}#secret=${encodeURIComponent(secretToken)}`;
+}
+
+/** Reads the secret back out of a URL fragment such as "#secret=abc". Returns "" when absent. */
+export function readSecretFromHash(hash: string): string {
+  return new URLSearchParams(hash.replace(/^#/, "")).get("secret") ?? "";
+}
