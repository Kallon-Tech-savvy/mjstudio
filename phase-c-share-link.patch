+/** Returned ONCE by create/regenerate. Only hashes are stored, so these cannot be fetched again. */
+export type GalleryAccessCredentials = {
+  id: string;
+  permission: "view" | "view_download";
+  expiresAt?: string | null;
+  secretToken: string;
+  pin: string;
+};
+
+type AccessInput = { permission: "view" | "view_download"; expiresAt?: string | null };
+
+export async function createGalleryAccess(galleryId: string, input: AccessInput): Promise<GalleryAccessCredentials> {
+  return apiRequest<GalleryAccessCredentials>(`/galleries/${galleryId}/access`, { method: "POST", body: JSON.stringify(input) });
+}
+
+/** Regenerate: revokes the current link, PIN and client sessions, and issues new ones. */
+export async function resetGalleryAccess(galleryId: string, input: AccessInput): Promise<GalleryAccessCredentials> {
+  return apiRequest<GalleryAccessCredentials>(`/galleries/${galleryId}/access/reset`, { method: "POST", body: JSON.stringify(input) });
+}
+
+export async function publishGallery(galleryId: string): Promise<{ id: string; publicationStatus: string; publishedAt?: string }> {
+  return apiRequest(`/galleries/${galleryId}/publish`, { method: "POST" });
+}
+
+export type GalleryAccessSummary = { id: string; permission: string; expiresAt?: string | null; revokedAt?: string | null };
+
+export async function listGalleryAccess(galleryId: string): Promise<{ items: GalleryAccessSummary[]; total: number }> {
+  return apiCollectionRequest<GalleryAccessSummary>(`/galleries/${galleryId}/access`, (item) => ({
+    id: String(item.id ?? ""),
+    permission: String(item.permission ?? "view"),
+    expiresAt: (item.expiresAt as string | null | undefined) ?? null,
+    revokedAt: (item.revokedAt as string | null | undefined) ?? null,
+  }));
 }
 
