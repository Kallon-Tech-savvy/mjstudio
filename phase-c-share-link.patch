@@ -0,0 +1,37 @@
+import request from 'supertest';
+import { describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+import { buildPhotographerContext } from '../src/auth/context.js';
+import { UnauthorizedError } from '../src/errors.js';
+import type { ApplicationServices } from '../src/services/container.js';
+
+const GALLERY = '55555555-5555-4555-8555-555555555555';
+const credentials = { id: 'a1', permission: 'view', expiresAt: null, secretToken: 'x'.repeat(43), pin: '012345' };
+
+function app() {
+  const services = {
+    auth: { login: async () => { throw new UnauthorizedError('Invalid email or password.'); }, resolve: async () => buildPhotographerContext(), logout: async () => undefined },
+    galleryAccess: { create: async () => credentials, reset: async () => ({ ...credentials, pin: '654321' }) },
+    catalog: {}, rateLimits: { assertAllowed: async () => undefined },
+  } as unknown as ApplicationServices;
+  return createApp(services, { allowedOrigins: ['http://localhost:3000'] });
+}
+const post = (path: string, body: object) =>
+  request(app()).post(path).set('Origin', 'http://localhost:3000').set('Cookie', '__Host-mj_session=valid').send(body);
+
+describe('gallery access credentials are returned once and never cached', () => {
+  it('create returns the secret token and PIN with Cache-Control: no-store', async () => {
+    const res = await post(`/api/galleries/${GALLERY}/access`, { permission: 'view' });
+    expect(res.status).toBe(201);
+    expect(res.headers['cache-control']).toBe('no-store');
+    expect(res.body.data.secretToken).toBe(credentials.secretToken);
+    expect(res.body.data.pin).toBe('012345');
+  });
+
+  it('reset (regenerate) returns fresh credentials with Cache-Control: no-store', async () => {
+    const res = await post(`/api/galleries/${GALLERY}/access/reset`, { permission: 'view_download' });
+    expect(res.status).toBe(200);
+    expect(res.headers['cache-control']).toBe('no-store');
+    expect(res.body.data.pin).toBe('654321');
+  });
+});
