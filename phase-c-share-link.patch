@@ -0,0 +1,87 @@
+import { useState } from "react";
+import type { GalleryAccessCredentials } from "@/lib/api";
+import { buildClientLink } from "@/lib/access-link";
+import { copyText, groupPin, linkMessage, pinMessage, whatsappUrl } from "../lib/share";
+
+type Props = {
+  galleryId: string;
+  galleryName: string;
+  clientName?: string;
+  clientPhone?: string | null;
+  credentials: GalleryAccessCredentials;
+  published: boolean;
+  busy: boolean;
+  error: string;
+  onPublish: () => void;
+  onRegenerate: () => void;
+};
+
+const box = "rounded-lg border border-white/15 bg-white/5 px-3 py-2.5";
+const smallBtn = "rounded-lg border border-white/20 px-3 py-2 text-sm hover:bg-white/10 disabled:opacity-40";
+
+/** Shown right after creating or regenerating access: the link and PIN appear here once. */
+export function SharePanel({ galleryId, galleryName, clientName, clientPhone, credentials, published, busy, error, onPublish, onRegenerate }: Props) {
+  const [copied, setCopied] = useState<"link" | "pin" | null>(null);
+  const link = buildClientLink(window.location.origin, galleryId, credentials.secretToken);
+  const canShare = typeof navigator !== "undefined" && typeof navigator.share === "function";
+
+  const copy = async (what: "link" | "pin") => {
+    const ok = await copyText(what === "link" ? link : credentials.pin);
+    setCopied(ok ? what : null);
+    if (ok) window.setTimeout(() => setCopied((c) => (c === what ? null : c)), 2000);
+  };
+  const regenerate = () => {
+    if (window.confirm("Regenerate the link and PIN? The current ones will stop working right away, including for a client who is already viewing.")) onRegenerate();
+  };
+
+  return (
+    <section className="mt-5 space-y-4 rounded-2xl border border-white/15 bg-white/5 p-5" aria-label="Send to client">
+      <div>
+        <h2 className="text-xl font-semibold">Send to {clientName || "your client"}</h2>
+        <p className="mt-1 text-sm text-amber-200">The PIN is shown only now. Copy or send it before you leave this page. If you lose it, regenerate.</p>
+      </div>
+
+      {!published ? (
+        <div className="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-300/40 bg-amber-300/10 px-3 py-2.5 text-sm">
+          <span>Not published yet. The client cannot open this link until you publish.</span>
+          <button type="button" className={smallBtn} disabled={busy} onClick={onPublish}>
+            {busy ? "Publishing…" : "Publish now"}
+          </button>
+        </div>
+      ) : null}
+      {error ? <div className="error-box">{error}</div> : null}
+
+      <div>
+        <span className="mb-1.5 block text-sm opacity-70">Link</span>
+        <div className="flex gap-2">
+          <input className={`${box} min-w-0 flex-1 text-sm`} readOnly value={link} aria-label="Client link" onFocus={(e) => e.currentTarget.select()} />
+          <button type="button" className={smallBtn} onClick={() => copy("link")}>{copied === "link" ? "Copied" : "Copy"}</button>
+        </div>
+      </div>
+
+      <div>
+        <span className="mb-1.5 block text-sm opacity-70">PIN</span>
+        <div className="flex items-center gap-2">
+          <div className={`${box} flex-1 font-mono text-2xl tracking-widest`} aria-label="PIN">{groupPin(credentials.pin)}</div>
+          <button type="button" className={smallBtn} onClick={() => copy("pin")}>{copied === "pin" ? "Copied" : "Copy"}</button>
+        </div>
+      </div>
+
+      <div className="flex flex-wrap gap-2">
+        <a className="primary-button" href={whatsappUrl(linkMessage({ clientName, galleryName, link }), clientPhone)} target="_blank" rel="noopener noreferrer">
+          Send link on WhatsApp
+        </a>
+        <a className="secondary-button" href={whatsappUrl(pinMessage(credentials.pin), clientPhone)} target="_blank" rel="noopener noreferrer">
+          Send PIN on WhatsApp
+        </a>
+        {canShare ? (
+          <button type="button" className="secondary-button" onClick={() => void navigator.share({ title: galleryName, text: linkMessage({ clientName, galleryName, link }), url: link }).catch(() => undefined)}>
+            Share…
+          </button>
+        ) : null}
+        <button type="button" className="secondary-button" disabled={busy} onClick={regenerate}>Regenerate</button>
+      </div>
+      <p className="text-xs opacity-60">The link and PIN go in two separate messages so one leaked message is not enough to open the gallery.</p>
+    </section>
+  );
+}
